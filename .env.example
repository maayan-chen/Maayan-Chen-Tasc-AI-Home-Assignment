# Copy to .env and fill in real values. .env is gitignored.

OPENAI_API_KEY=

# Used directly if present (takes priority over the individual POSTGRES_* vars
# below). Docker Compose sets this automatically for the app service.
PGVECTOR_CONNECTION=
PGVECTOR_COLLECTION=default

# Only needed if PGVECTOR_CONNECTION is not set directly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
